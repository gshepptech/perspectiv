{
  "uid": "perspectiv-overview",
  "title": "Perspectiv overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "perspectiv"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API calls by code",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(rpc_requests_total[5m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server error ratio (internal, unknown, unavailable)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rpc_requests_total{code=~\"internal|unknown|unavailable|data_loss\"}[5m])) / clamp_min(sum(rate(rpc_requests_total[5m])), 1e-9)",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency by procedure",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, procedure) (rate(rpc_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{procedure}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Refusals by procedure (rate limited, denied, signed out)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (procedure, code) (rate(rpc_requests_total{code=~\"resource_exhausted|permission_denied|unauthenticated\"}[5m]))",
          "legendFormat": "{{procedure}} {{code}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Background failures",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(job_failures_total[15m]))",
          "legendFormat": "job attempts failed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(email_send_failures_total[15m]))",
          "legendFormat": "email sends failed"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Product activity",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(perspectives_published_total[1h]))",
          "legendFormat": "published / h"
        },
        {
          "refId": "B",
          "expr": "sum(increase(claims_accepted_total[1h]))",
          "legendFormat": "claims accepted / h"
        },
        {
          "refId": "C",
          "expr": "sum(increase(canon_changes_total[1h]))",
          "legendFormat": "canon changes / h"
        }
      ]
    }
  ]
}
