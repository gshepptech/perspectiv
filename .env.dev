# Development defaults for the local dev loop. Tracked, holds no secrets, and
# is never edited for local tweaks: scripts/dev.sh copies it to the gitignored
# .env.dev.local on first run, and that copy is the file you edit. Both files
# are sourced in that order, so a value in .env.dev.local wins.

# --- server (read only by cmd/perspectiv) ---
ROLE=all
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=postgres://perspectiv:perspectiv@localhost:5432/perspectiv?sslmode=disable
# Development placeholder only. Production reads a generated secret from the
# cluster; never reuse this value anywhere reachable.
JWT_SECRET=dev-only-placeholder-not-a-secret-0123456789abcdef
# The age key that encrypts two-factor secrets at rest. Left empty here so no
# key is ever tracked: the first make dev-up generates one into
# .env.dev.local, which wins over this line.
ENCRYPTION_KEYS=
# Plain HTTP on localhost, so the refresh cookie cannot be Secure here.
COOKIE_SECURE=false
MAIL_PROVIDER=smtp
SMTP_ADDR=localhost:1025
MAIL_FROM="Perspectiv <no-reply@perspectiv.local>"
RESEND_API_KEY=
RANK_INTERVAL=60s
CANON_MIN_MEMBERS=4
# open lets anyone sign up; invite (the default when unset) needs a beta code
# or a member's invite link. Production runs invite during the beta.
SIGNUP_MODE=open
EXPIRY_WINDOW=168h
AVATAR_DIR=tmp/dev/avatars
MIGRATE_ON_START=false
LOG_LEVEL=debug
# Empty disables trace export. Set to http://localhost:4317 after make dev-grafana.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- containers started by scripts/dev.sh ---
# A changed POSTGRES_PORT or MAILPIT_SMTP_PORT also needs DATABASE_URL or
# SMTP_ADDR above changed to match; MAILPIT_URL follows MAILPIT_HTTP_PORT.
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_PORT=5432
POSTGRES_USER=perspectiv
POSTGRES_PASSWORD=perspectiv
POSTGRES_DB=perspectiv
MAILPIT_IMAGE=axllent/mailpit:v1.31.6
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
MAILPIT_URL=http://localhost:8025

# --- observability stack (make dev-grafana) ---
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
LOKI_PORT=3100

# --- web and E2E ---
WEB_PORT=5173
BASE_URL=http://localhost:5173
